# Copy to .env

# Public hostname (apex). Apps are {slug}.{BASE_DOMAIN}.
BASE_DOMAIN=handson.tools

# Default FLOW origin for the apex one-link (also editable in /admin).
FLOW_BASE_URL=https://flow.hands-on-technology.org

PORT=3000
NODE_ENV=production

# Keycloak (admin UI at https://handson.tools/admin)
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_CALLBACK_URL=https://handson.tools/auth/keycloak/callback
SESSION_SECRET=
# Client role on KEYCLOAK_CLIENT_ID (default: handson-tools-admin)
# KEYCLOAK_ADMIN_ROLE=handson-tools-admin

# Behind Traefik cookies are secure in production. Local HTTP: COOKIE_SECURE=false
# COOKIE_SECURE=false

# Egress. The gateway dials upstreams directly and, in parallel, through the
# SNI hop on the host; the first finished TLS handshake wins. Compose sets
# EGRESS_HOP_HOST=host.docker.internal. Leave it empty to go direct only.
# Do not open 4180 on the Hetzner firewall — the hop relays any TLS host.
# EGRESS_HOP_HOST=
# EGRESS_HOP_PORT=4180
# EGRESS_HOP_DELAY_MS=250
# EGRESS_CONNECT_TIMEOUT_MS=10000
# UPSTREAM_TIMEOUT_MS=30000
