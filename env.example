# Copy to .env

# Public hostname (apex). Apps are {slug}.{BASE_DOMAIN}.
BASE_DOMAIN=handson.tools

# Default FLOW origin for the apex one-link (also editable in /admin).
FLOW_BASE_URL=https://flow.hands-on-technology.org

PORT=3000
NODE_ENV=production

# Keycloak (admin UI at https://handson.tools/admin)
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_CALLBACK_URL=https://handson.tools/auth/keycloak/callback
SESSION_SECRET=
ALLOWED_EMAILS=

# Behind Traefik cookies are secure in production. Local HTTP: COOKIE_SECURE=false
# COOKIE_SECURE=false

# Traefik docker-compose
# TRAEFIK_NETWORK=traefik
# TRAEFIK_CERT_RESOLVER=le
