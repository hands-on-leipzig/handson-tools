# Keycloak OAuth Configuration
# Copy this file to .env and fill in your values

# Keycloak server URL and realm
# Example: https://keycloak.example.com/realms/your-realm
KEYCLOAK_ISSUER=

# Client ID from Keycloak
KEYCLOAK_CLIENT_ID=

# Client Secret from Keycloak
KEYCLOAK_CLIENT_SECRET=

# Callback URL (usually doesn't need to be changed)
KEYCLOAK_CALLBACK_URL=https://handson.tools/auth/keycloak/callback

# Session secret (generate a random string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: Restrict access to specific emails/domains (comma-separated)
# Examples:
#   ALLOWED_EMAILS=user@example.com,another@example.com
#   ALLOWED_EMAILS=example.com,another-domain.org
# Leave empty to allow any authenticated user
ALLOWED_EMAILS=

# Server port (default: 3000)
PORT=3000



