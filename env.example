# Copy to .env

# Public hostname (apex). Apps are {slug}.{BASE_DOMAIN}.
BASE_DOMAIN=handson.tools

# Default FLOW origin for the apex one-link (also editable in /admin).
FLOW_BASE_URL=https://flow.hands-on-technology.org

PORT=3000
NODE_ENV=production

# Keycloak (admin UI at https://handson.tools/admin)
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_CALLBACK_URL=https://handson.tools/auth/keycloak/callback
SESSION_SECRET=
# Client role on KEYCLOAK_CLIENT_ID (default: handson-tools-admin)
# KEYCLOAK_ADMIN_ROLE=handson-tools-admin

# Behind Traefik cookies are secure in production. Local HTTP: COOKIE_SECURE=false
# COOKIE_SECURE=false

# Compose sets FLOW_HOP_HOST so HTTPS upstreams (FLOW, timer, …) leave via
# the host hop on :4180 (IPv4 listen, Happy Eyeballs to the SNI host).
# Do not open port 4180 on the Hetzner firewall.
