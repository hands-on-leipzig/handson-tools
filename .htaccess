# Enable mod_rewrite
RewriteEngine On

# Force HTTPS redirect
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Disable directory listing
Options -Indexes
DirectoryIndex disabled

# Never hand out the application itself. Without this, Apache serves any existing file
# in this directory — including .env with the Keycloak client secret.
<FilesMatch "^(\.|env\.example$|urls\.json$|shorts\.json$|server\.js$|package(-lock)?\.json$|ecosystem\.config\.js$|start-pm2\.sh$|.*\.md$)">
  Require all denied
</FilesMatch>

# Proxy all requests to Node.js on port 3000 (HTTP)
# The [P] flag proxies internally - URL stays as handson.tools (no :3000)
# Apache handles HTTPS termination, then proxies to Node.js internally
# Everything goes to Node, which also serves public assets (favicon.ico, hot.png,
# Glass CSS/fonts). Letting Apache answer for existing files first would expose the rest.

# Explicitly handle root path
RewriteRule ^$ http://127.0.0.1:3000/ [P,L]

# Proxy all other requests
RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
