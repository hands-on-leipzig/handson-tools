{
  "name": "handson-tools",
  "version": "2.0.0",
  "description": "handson.tools gateway — subdomain apps and FLOW one-link proxy",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test src/*.test.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop domain-shortener",
    "pm2:restart": "pm2 restart domain-shortener",
